# Local development configuration.
# Copy to .env and adjust values for your machine. Never commit .env.
#
# These are development placeholders only. Real environments require unique,
# least-privilege database credentials and secret storage outside Git.

# PostgreSQL (shared server, one database per service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=mathzero_admin
POSTGRES_ADMIN_PASSWORD=change-me-locally

# RabbitMQ (domain events from Phase 7)
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=mathzero
RABBITMQ_DEFAULT_PASSWORD=change-me-locally

# Service discovery and gateway
EUREKA_PORT=8761
EUREKA_URL=http://localhost:8761/eureka/
GATEWAY_PORT=8090
APP_VERSION=0.1.0
APP_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Logical databases (created by infra/docker/postgres/init/01-databases.sql)
IDENTITY_DB=identity_db
CURRICULUM_DB=curriculum_db
CONTENT_DB=content_db
RESOURCE_DB=resource_db
EXERCISE_DB=exercise_db
LEARNING_DB=learning_db
GAMIFICATION_DB=gamification_db
ANALYTICS_DB=analytics_db

# Identity (Phase 2)
IDENTITY_PORT=8091
IDENTITY_DB_URL=jdbc:postgresql://localhost:5432/identity_db
IDENTITY_DB_USERNAME=mathzero_admin
IDENTITY_DB_PASSWORD=change-me-locally
CURRICULUM_PORT=8082
CURRICULUM_DB_URL=jdbc:postgresql://localhost:5432/curriculum_db
CURRICULUM_DB_USERNAME=mathzero_admin
CURRICULUM_DB_PASSWORD=change-me-locally
RESOURCE_PORT=8089
RESOURCE_DB_URL=jdbc:postgresql://localhost:5432/resource_db
RESOURCE_DB_USERNAME=mathzero_admin
RESOURCE_DB_PASSWORD=change-me-locally
AUTH_JWT_SECRET=change-this-local-development-secret-at-least-32-bytes
AUTH_ACCESS_TOKEN_SECONDS=900
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_COOKIE_SECURE=false

# Angular: the browser calls the Gateway only.
ANGULAR_API_BASE_URL=http://localhost:8090/api/v1

# External provider credentials are server-side secrets (Phase 4A).
# Never expose them to Angular, logs or source control.
WIKIMEDIA_ENABLED=true
# Optional external catalogues. Disabled until explicitly enabled and reviewed.
OPENSTAX_ENABLED=false
OPENSTAX_API_URL=https://openstax.org/apps/cms/api/v2
OPENSTAX_SITE_URL=https://openstax.org
# The public catalogue needs no credentials. For authenticated access, set
# either a bearer token or an OAuth token URL with client id/secret.
OPENSTAX_BEARER_TOKEN=
OPENSTAX_TOKEN_URL=
OPENSTAX_CLIENT_ID=
OPENSTAX_CLIENT_SECRET=
GEOGEBRA_ENABLED=false
GEOGEBRA_API_URL=https://api.geogebra.org/v1.0
GEOGEBRA_SITE_URL=https://www.geogebra.org
PHET_ENABLED=false
PHET_METADATA_URL=https://phet.colorado.edu/services/metadata/1.3/simulations
PHET_SITE_URL=https://phet.colorado.edu
PHET_METADATA_CACHE_SECONDS=3600
YOUTUBE_API_KEY=
YOUTUBE_ENABLED=false
CNTE_AUTHORIZED=false
CNTE_API_URL=
CNTE_API_TOKEN=
# Suggestion board tuning (shared by all enabled providers).
SUGGESTIONS_CACHE_TTL=15m
SUGGESTIONS_LIMIT_PER_QUERY=5
SUGGESTIONS_MAX_PER_CYCLE=10
# Wikimedia search has no key; suggestions come only from enabled providers.
